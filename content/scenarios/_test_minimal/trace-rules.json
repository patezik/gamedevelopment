[
  {
    "verb": "take",
    "when": {
      "targetTag": "record"
    },
    "produces": [
      {
        "kind": "document",
        "at": "loc_archive",
        "template": "missing_record",
        "supports": ["took_record($actor,$location)"],
        "requires": {
          "itemId": "it_log"
        }
      }
    ]
  },
  {
    "verb": "stay",
    "produces": [
      {
        "kind": "document",
        "at": "$location",
        "template": "visitor_register",
        "supports": ["presence($actor,$location,$span)"]
      }
    ]
  },
  {
    "verb": "hide",
    "produces": [
      {
        "kind": "physical",
        "at": "$location",
        "template": "disturbed_dust",
        "supports": ["presence($actor,$location,$t)"]
      }
    ]
  },
  {
    "verb": "destroy",
    "produces": [
      {
        "kind": "physical",
        "at": "$location",
        "template": "ash_residue",
        "supports": ["presence($actor,$location,$t)"]
      }
    ]
  },
  {
    "verb": "stage",
    "produces": [
      {
        "kind": "physical",
        "at": "$location",
        "template": "staged_scene",
        "supports": ["opportunity($actor)"]
      }
    ]
  }
]
