{
  "name": "hollow-signal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Detective survival horror roguelike: Godot desktop client, Expo companion app, Node.js session server, headless TypeScript game core.",
  "engines": {
    "node": ">=24.3 <25"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/mobile",
    "tools/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tasks:check": "node tools/tasks/tasks.mjs validate",
    "tasks:ready": "node tools/tasks/tasks.mjs ready",
    "tasks:index": "node tools/tasks/tasks.mjs index",
    "docs:check": "node tools/docs/check-links.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "~5.0.5",
    "eslint": "^10.14.0",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "~5.0.5"
  }
}
