{
  "name": "hollow-signal",
  "version": "0.0.0",
  "private": true,
  "description": "Detective survival horror roguelike: Godot desktop client, Expo companion app, Node.js session server, headless TypeScript game core.",
  "engines": {
    "node": ">=24.3 <25"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/mobile",
    "tools/*"
  ],
  "scripts": {
    "tasks:check": "node tools/tasks/tasks.mjs validate",
    "tasks:ready": "node tools/tasks/tasks.mjs ready",
    "tasks:index": "node tools/tasks/tasks.mjs index",
    "docs:check": "node tools/docs/check-links.mjs"
  }
}
