{
  "name": "hollow-signal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Detective survival horror roguelike: Godot desktop client, Expo companion app, Node.js session server, headless TypeScript game core.",
  "engines": {
    "node": ">=24.3 <25"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/mobile",
    "tools/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "scripts": {
    "dev:server": "npm run dev -w @hs/server",
    "dev:mobile": "npm run start -w @hs/mobile",
    "test:all": "npm test && npm test -w @hs/mobile && npm run test:godot",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:godot": "node tools/test-godot.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tasks:check": "node tools/tasks/tasks.mjs validate",
    "tasks:ready": "node tools/tasks/tasks.mjs ready",
    "tasks:index": "node tools/tasks/tasks.mjs index",
    "docs:check": "node tools/docs/check-links.mjs",
    "protocol:gen": "npm run protocol:gen -w @hs/protocol",
    "protocol:check": "npm run protocol:check -w @hs/protocol",
    "bench": "node packages/core/test/performance/scheduler.ts && node packages/core/test/performance/simulation.ts && node --experimental-transform-types packages/generator/test/performance/history-sim.ts && node --experimental-transform-types packages/generator/bench/generation.ts",
    "sweep": "node --experimental-transform-types packages/validator/bin/hs-sweep.ts",
    "content:check": "node tools/check-content.mjs",
    "art:check": "node tools/art/check-art.mjs",
    "art:reference": "node tools/art/reference/render.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "~5.0.5",
    "eslint": "^10.14.0",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "~5.0.5"
  }
}
