# Session Server reads the process environment. To load a file explicitly from
# the repository root: node --env-file=.env apps/server/src/server.ts
HS_PORT=7420
HS_HOST=0.0.0.0
HS_LOG_LEVEL=info
HS_DEBUG_TRUTH=0

# Optional LAN IPv4 address or hostname without a port (auto-detect by default).
# HS_PUBLIC_HOST=192.168.1.42
# Optional data directory (defaults to .hollow-signal in the user's home).
# HS_DATA_DIR=.hs-data
