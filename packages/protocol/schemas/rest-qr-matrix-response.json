{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "size": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "modules": {
      "type": "string",
      "pattern": "^[01]+$"
    }
  },
  "required": [
    "size",
    "modules"
  ],
  "additionalProperties": false
}
