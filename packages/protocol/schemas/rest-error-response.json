{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_MESSAGE",
            "UNAUTHORIZED",
            "PROTOCOL_MISMATCH",
            "SESSION_NOT_FOUND",
            "SESSION_CLOSED",
            "SCENARIO_NOT_FOUND",
            "PAIRING_CODE_INVALID",
            "PAIRING_CODE_EXPIRED",
            "PAIRING_RATE_LIMITED",
            "DEVICE_REVOKED",
            "ACTION_INVALID",
            "ACTION_NOT_AVAILABLE",
            "ACTION_BLOCKED",
            "GAME_OVER",
            "QR_INVALID",
            "QR_WRONG_SESSION",
            "QR_EXPIRED",
            "QR_ALREADY_USED",
            "QR_PRECONDITION_FAILED",
            "SAVE_NOT_FOUND",
            "SAVE_DESYNC",
            "GENERATION_UNSOLVABLE",
            "RATE_LIMITED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "atAction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
