{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "battery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "signal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "time",
        "battery",
        "signal"
      ],
      "additionalProperties": false
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "badge": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "badge",
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "portraitRef": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "number"
        ],
        "additionalProperties": false
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contactId": {
            "type": "string",
            "minLength": 1
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "enum": [
                    "me",
                    "them"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "at": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "read": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "from",
                "text",
                "at",
                "read"
              ],
              "additionalProperties": false
            }
          },
          "availableReplies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "unread": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "typing": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "contactId",
          "messages",
          "availableReplies",
          "unread"
        ],
        "additionalProperties": false
      }
    },
    "callLog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contactId": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "incoming",
              "outgoing",
              "missed"
            ]
          },
          "at": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "contactId",
          "direction",
          "at",
          "durationMinutes"
        ],
        "additionalProperties": false
      }
    },
    "activeCall": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 1
        },
        "contactId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "ringing",
            "active"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "speaker": {
                "type": "string",
                "enum": [
                  "player",
                  "other"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "speaker",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "callId",
        "contactId",
        "state",
        "lines",
        "choices"
      ],
      "additionalProperties": false
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "imageRef": {
            "type": "string"
          },
          "takenAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "caption": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "imageRef",
          "takenAt"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "locked": {
            "type": "boolean"
          },
          "passwordHint": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "locked"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "auto",
              "player"
            ]
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "source",
          "text",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "mapPins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locationId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "seenAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "locationId",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "browserPages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "appId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "read": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "appId",
          "title",
          "text",
          "at",
          "read"
        ],
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "glitchLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "wallpaperVariant": {
          "type": "string"
        }
      },
      "required": [
        "glitchLevel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "apps",
    "contacts",
    "threads",
    "callLog",
    "gallery",
    "files",
    "notes",
    "mapPins",
    "browserPages",
    "notifications",
    "effects"
  ],
  "additionalProperties": false
}
