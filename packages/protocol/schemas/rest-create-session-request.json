{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "seed": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "locale": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ]
    }
  },
  "required": [
    "scenarioId"
  ],
  "additionalProperties": false
}
