{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{6}$"
    },
    "expiresAt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "qrPayload": {
      "type": "string",
      "pattern": "^hs1:pair:[^:]+:[0-9]{1,5}:[0-9A-HJKMNP-TV-Z]{6}$"
    }
  },
  "required": [
    "code",
    "expiresAt",
    "qrPayload"
  ],
  "additionalProperties": false
}
