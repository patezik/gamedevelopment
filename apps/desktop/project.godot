config_version=5

[application]

config/name="Hollow Signal"
config/version="0.0.0"
run/main_scene="res://src/scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Backend="*res://src/autoload/backend.gd"
ServerLauncher="*res://src/autoload/server_launcher.gd"
GameStore="*res://src/autoload/game_store.gd"
SceneRouter="*res://src/autoload/scene_router.gd"
Settings="*res://src/autoload/settings.gd"
Localization="*res://src/autoload/localization.gd"
AudioDirector="*res://src/autoload/audio_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
